# `dbu6 setup` copies this file to .env.development and fills in
# BETTER_AUTH_SECRET. Every `dbu6` command reads it, and the `sapporta` command
# finds SAPPORTA_API_PORT here.
# A value already in the environment wins over this file.

# dbu6 serves the app and its API on this port.
SAPPORTA_API_PORT=2345
# The address you open in the browser. Auth and email links are built from it.
SAPPORTA_PUBLIC_APP_URL=http://localhost:2345

# Only `dbu6 dev` uses these, in a project with reports or a frontend.tsx: it
# serves the screens with hot reload on the frontend port.
SAPPORTA_FRONTEND_PORT=2340
SAPPORTA_FRONTEND_ORIGINS=http://localhost:2340

# Signs session cookies. Filled in by `dbu6 setup` when left blank; changing it
# later only signs everyone out.
BETTER_AUTH_SECRET=

SAPPORTA_REQUIRE_VERIFIED_EMAIL=false
SAPPORTA_HEALTH_POLICY=public

# "stream" prints outgoing mail to the terminal instead of sending it. For
# real mail set it to "smtp" and fill in the SMTP values.
SAPPORTA_MAIL_TRANSPORT=stream
SAPPORTA_MAIL_FROM="dbu6 <no-reply@example.test>"

SMTP_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# ==============================================================================
# Google Gemini API & Antigravity Model Configuration
# ==============================================================================
# Paste your Google AI Studio API Key below (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Active Model for Fast Transaction Categorization (Default: gemini-3.8-flash)
# Supported options: gemini-3.8-flash, gemini-flash-latest, gemini-3.5-flash
GEMINI_CATEGORIZATION_MODEL=gemini-3.8-flash

# Active Model for Deep Reasoning & Coding Sessions (Default: gemini-3.1-pro-preview)
# Supported options: gemini-3.1-pro-preview, gemini-pro-latest
GEMINI_SESSION_MODEL=gemini-3.1-pro-preview
