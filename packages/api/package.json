{
  "name": "dbu6-api",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter dbu6-shared build",
    "dev": "tsc-watch --onFirstSuccess \"node --env-file=../../.env.development --watch dist/boot.js\"",
    "prebuild": "pnpm --filter dbu6-shared build",
    "build": "tsc",
    "start": "node dist/boot.js",
    "db:generate": "node --env-file=../../.env.development node_modules/drizzle-kit/bin.cjs generate",
    "db:generate:custom": "node --env-file=../../.env.development node_modules/drizzle-kit/bin.cjs generate --custom",
    "db:migrate": "node --env-file=../../.env.development node_modules/drizzle-kit/bin.cjs migrate",
    "db:check": "node --env-file=../../.env.development node_modules/drizzle-kit/bin.cjs check",
    "db:studio": "node --env-file=../../.env.development node_modules/drizzle-kit/bin.cjs studio",
    "pretypecheck": "pnpm --filter dbu6-shared build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@casl/ability": "7.0.0",
    "@sapporta/honest": "0.3.15",
    "@sapporta/rest-core": "3.52.2",
    "@sapporta/server": "0.7.0",
    "@sapporta/shared": "0.3.3",
    "dbu6-shared": "workspace:*",
    "@better-auth/drizzle-adapter": "1.6.22",
    "better-auth": "1.6.22",
    "@hono/node-server": "2.0.6",
    "hono": "4.12.29",
    "nodemailer": "9.0.1",
    "drizzle-orm": "0.45.2",
    "better-sqlite3": "12.11.1",
    "nuabase": "2.3.5",
    "@js-temporal/polyfill": "0.5.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "tsc-watch": "^7.2.0",
    "drizzle-kit": "0.31.10",
    "@types/better-sqlite3": "^7.6.0",
    "@types/nodemailer": "8.0.1",
    "vitest": "^3.1.0"
  }
}
