{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "dbu6-shared": ["../shared/dist/index.d.ts"]
    }
  },
  "include": [
    "*.ts",
    "app",
    "bank-importer",
    "coding-agent",
    "project-auth",
    "schema"
  ],
  "exclude": ["dist"]
}
