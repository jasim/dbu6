{
  "name": "dbu6",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "bin": {
    "dbu6": "./bin/dbu6.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "browser": "./dist/shared/report-contract.js",
      "default": "./dist/server/index.js"
    },
    "./frontend": {
      "types": "./dist/frontend/index.d.ts",
      "default": "./dist/frontend/index.js"
    },
    "./frontend.css": "./dist/frontend/frontend.css"
  },
  "files": [
    "bin/",
    "dist/",
    "migrations/",
    "template/",
    "docs/",
    "custom-built-parsers/",
    "user-config.example/",
    "DBU6-BOOKS.md",
    "npm-shrinkwrap.json",
    "!**/fixtures/",
    "!**/*_test.py",
    "!**/*.test.*",
    "!**/__tests__/",
    "!**/__pycache__/",
    "!**/*.pyc",
    "!**/*.tsbuildinfo",
    "!docs/frontend-host-findings.md",
    "!docs/examples/tsconfig.json",
    "docs/examples/report/api.test.ts"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "dbu6": "node bin/dbu6.mjs",
    "setup": "node bin/dbu6.mjs setup",
    "seed": "node bin/dbu6.mjs seed",
    "dev": "node bin/dbu6.mjs dev",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/frontend --noEmit && tsc -p docs/examples",
    "typecheck:watch": "tsc -p src/frontend --noEmit --watch --preserveWatchOutput",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "test": "vitest run && pnpm run test:scripts",
    "test:watch": "vitest",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "test:parsers": "node bin/dbu6.mjs parser test",
    "prebuild": "pnpm run clean && pnpm typecheck",
    "build": "node scripts/build.mjs",
    "start": "node bin/dbu6.mjs start",
    "migrate": "node bin/dbu6.mjs migrate",
    "db:generate": "node --env-file=.env.development node_modules/drizzle-kit/bin.cjs generate",
    "db:generate:custom": "node --env-file=.env.development node_modules/drizzle-kit/bin.cjs generate --custom",
    "db:migrate": "node --env-file=.env.development node_modules/drizzle-kit/bin.cjs migrate",
    "db:check": "node --env-file=.env.development node_modules/drizzle-kit/bin.cjs check",
    "db:studio": "node --env-file=.env.development node_modules/drizzle-kit/bin.cjs studio",
    "pii-scan": "node scripts/pii-scan.mjs --tracked",
    "pii-scan:pack": "node scripts/pii-scan.mjs --pack",
    "pack:tarball": "node scripts/pack.mjs",
    "pack:verify": "node scripts/pack.mjs --local-sapporta --out tmp/pack && node scripts/verify-tarball.mjs tmp/pack tmp/pack-project",
    "pack:verify-init": "node scripts/pack.mjs --local-sapporta --out tmp/pack && node scripts/verify-init.mjs tmp/pack tmp/init-project",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "node scripts/release.mjs --refuse-direct-publish",
    "package-sources": "node scripts/package-source-switch.mjs",
    "package-sources:status": "node scripts/package-source-switch.mjs status",
    "package-sources:update-npm": "node scripts/package-source-switch.mjs update-npm",
    "package-sources:use-npm": "node scripts/package-source-switch.mjs use:npm",
    "package-sources:use-local": "node scripts/package-source-switch.mjs use:local",
    "package-sources:verify": "node scripts/package-source-switch.mjs verify"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth/drizzle-adapter": "1.6.22",
    "@casl/ability": "7.0.0",
    "@hono/node-server": "2.0.6",
    "@js-temporal/polyfill": "0.5.1",
    "@sapporta/frontend": "link:/Users/jasim/m/a/code/sapporta/packages/frontend",
    "@sapporta/grid": "link:/Users/jasim/m/a/code/sapporta/packages/grid",
    "@sapporta/honest": "link:/Users/jasim/m/a/code/sapporta/packages/honest",
    "@sapporta/rest-core": "3.52.2",
    "@sapporta/server": "link:/Users/jasim/m/a/code/sapporta/packages/core",
    "@sapporta/shared": "link:/Users/jasim/m/a/code/sapporta/packages/shared",
    "@sapporta/ui": "link:/Users/jasim/m/a/code/sapporta/packages/ui",
    "@tailwindcss/vite": "4.3.1",
    "@tanstack/react-query": "^5.101.4",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "better-auth": "1.6.22",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "^0.7.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.29",
    "lucide-react": "1.21.0",
    "nodemailer": "9.0.1",
    "nuabase": "2.3.5",
    "react": "19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.0",
    "tailwindcss": "4.3.1",
    "typescript": "^6.0.3",
    "vite": "8.1.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.1",
    "drizzle-kit": "0.31.10",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.6",
    "tsc-watch": "^7.2.0",
    "use-sync-external-store": "^1.7.0",
    "vitest": "^3.2.7"
  }
}
