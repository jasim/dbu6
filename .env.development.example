# Copy to .env.development. Development ports and their derived URLs are
# configured in mise.toml.

# The directory that holds this app's SQLite database (sqlite.db) and
# user-config/. A relative path is resolved against the project root, the
# directory with sapporta.json. An absolute path also works. `pnpm dev`,
# `pnpm setup`, and every `pnpm db:*` script read it from this file, so all of
# them open the same database. To work against a different database, for
# example one with sample data, change the path here.
SAPPORTA_DATA_DIR=data

# Any long random string, e.g. the output of `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# In development /api/* is reached through Vite's proxy on SAPPORTA_PUBLIC_APP_URL.
# Set SAPPORTA_FRONTEND_ORIGINS only when you need additional browser origins.
SAPPORTA_REQUIRE_VERIFIED_EMAIL=false
SAPPORTA_HEALTH_POLICY=public

SAPPORTA_MAIL_TRANSPORT=stream
SAPPORTA_MAIL_FROM="Sapporta <no-reply@example.test>"

SMTP_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
