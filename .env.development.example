# The development environment. `pnpm dev` creates .env.development from this
# file on first run and fills in BETTER_AUTH_SECRET, so there is nothing to copy
# by hand.
#
# A value already in the environment wins over this file, so a mise.toml or a
# plain shell export overrides any setting here without editing it.

# Development ports and the URLs derived from them. Vite serves the SPA on the
# frontend port and proxies /api/* to the API port; the API trusts the public
# app URL and builds auth and email links from it.
SAPPORTA_FRONTEND_PORT=2340
SAPPORTA_API_PORT=2345
SAPPORTA_PUBLIC_APP_URL=http://localhost:2340
SAPPORTA_API_URL=http://localhost:2345

# The directory that holds this app's SQLite database (sqlite.db). A relative path is resolved against the project root, the
# directory with sapporta.json. An absolute path also works. `pnpm dev`,
# `pnpm setup`, and every `pnpm db:*` script read it from this file, so all of
# them open the same database. To work against a different database, for
# example one with sample data, change the path here.
SAPPORTA_DATA_DIR=data

# Filled in by `pnpm setup` when left blank. Any long random string, e.g. the
# output of `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# In development /api/* is reached through Vite's proxy on SAPPORTA_PUBLIC_APP_URL.
# Set SAPPORTA_FRONTEND_ORIGINS only when you need additional browser origins.
SAPPORTA_REQUIRE_VERIFIED_EMAIL=false
SAPPORTA_HEALTH_POLICY=public

SAPPORTA_MAIL_TRANSPORT=stream
SAPPORTA_MAIL_FROM="Sapporta <no-reply@example.test>"

SMTP_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
